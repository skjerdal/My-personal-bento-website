---
interface Props {
  tag?: string;
  num?: string;
  label?: string;
}

const { tag = 'Now', num = 'M.Sc.', label = 'AI specialization<br />NTNU - 2025-27' } = Astro.props;

const startDate = new Date('2025-08-01');
const endDate   = new Date('2027-06-30');
const now       = new Date();
const total     = endDate.getTime() - startDate.getTime();
const elapsed   = Math.max(0, Math.min(now.getTime() - startDate.getTime(), total));
const progress  = Math.round((elapsed / total) * 100);
---

<article class="now-card">
  <p class="stats-tag">{tag}</p>
  <div>
    <p class="stats-num">{num}</p>
    <p class="stats-label" set:html={label} />
  </div>
  <div class="progress-section">
    <div class="progress-header">
      <span class="progress-label">Progress to degree</span>
      <span class="progress-pct">{progress}%</span>
    </div>
    <div class="progress-track">
      <div class="progress-fill" style={`width: ${progress}%`}></div>
    </div>
    <p class="progress-end">Jun 2027</p>
  </div>
</article>

<style>
  .now-card {
    --card-orange: #e8590c;
    --card-orange-deep: #c2410c;
    --card-cream-ink: #fff8ee;

    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 22px;
    border-radius: 24px;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(120% 80% at 0% 0%, rgba(255, 203, 107, 0.6), transparent 50%),
      radial-gradient(120% 80% at 100% 100%, rgba(255, 106, 42, 0.55), transparent 50%),
      linear-gradient(135deg, var(--card-orange) 0%, var(--card-orange-deep) 100%);
    border: 1px solid rgba(255, 220, 170, 0.4);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.4) inset,
      0 10px 30px -14px rgba(232, 89, 12, 0.55),
      0 8px 32px -8px rgba(26, 20, 16, 0.12),
      0 22px 50px -28px rgba(26, 20, 16, 0.22);
    color: var(--card-cream-ink);
    min-height: 180px;
    box-sizing: border-box;
    animation: rise 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .now-card:hover {
    transform: translateY(-4px);
  }

  .now-card::after {
    content: "";
    position: absolute;
    right: -80px;
    bottom: -80px;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 203, 107, 0.34), transparent 60%);
    filter: blur(40px);
    pointer-events: none;
  }

  .now-card > * {
    position: relative;
    z-index: 1;
  }

  .stats-tag {
    margin: 0;
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--type-font-label);
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-tracking);
    line-height: var(--type-label-line);
    text-transform: uppercase;
  }

  .stats-num {
    margin: 0;
    color: white;
    font-family: var(--type-font-display);
    font-size: var(--type-stat-size);
    font-style: var(--type-display-style);
    font-weight: var(--type-stat-weight);
    letter-spacing: 0;
    line-height: var(--type-stat-line);
  }

  .stats-label {
    margin: 4px 0 0;
    color: rgba(255, 255, 255, 0.9);
    font-family: var(--type-font-body);
    font-size: var(--type-caption-size);
    line-height: var(--type-caption-line);
  }

  .progress-section {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 12px;
  }

  .progress-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .progress-label {
    font-family: var(--type-font-label);
    font-size: calc(var(--type-label-size) * 0.9);
    letter-spacing: var(--type-label-tracking);
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }

  .progress-pct {
    font-family: var(--type-font-label);
    font-size: var(--type-label-size);
    font-weight: var(--type-weight-bold);
    color: rgba(255, 255, 255, 0.95);
  }

  .progress-track {
    height: 5px;
    border-radius: 99px;
    background: rgba(0, 0, 0, 0.18);
    overflow: hidden;
    position: relative;
  }

  .progress-track::after {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.05) 0 6px, transparent 6px 12px);
  }

  .progress-fill {
    height: 100%;
    border-radius: 99px;
    background: linear-gradient(90deg, #fff7e6, #ffd9a8);
    box-shadow: 0 0 12px rgba(255, 255, 255, 0.4);
    position: relative;
    z-index: 1;
    transition: width 1s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .progress-end {
    margin: 0;
    text-align: right;
    font-family: var(--type-font-label);
    font-size: calc(var(--type-label-size) * 0.8);
    letter-spacing: var(--type-label-tracking);
    color: rgba(255, 255, 255, 0.55);
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>
