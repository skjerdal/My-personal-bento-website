---
interface Props {
  tag?: string;
  num?: string;
  label?: string;
}

const { tag = 'Now', num = 'M.Sc.', label = 'AI specialization<br />NTNU - 2025-27' } = Astro.props;

const startDate = new Date('2025-08-01');
const endDate   = new Date('2027-06-30');
const now       = new Date();
const total     = endDate.getTime() - startDate.getTime();
const elapsed   = Math.max(0, Math.min(now.getTime() - startDate.getTime(), total));
const progress  = Math.round((elapsed / total) * 100);
---

<article class="now-card">
  <p class="stats-tag">{tag}</p>
  <div>
    <p class="stats-num">{num}</p>
    <p class="stats-label" set:html={label} />
  </div>
  <div class="progress-section">
    <div class="progress-header">
      <span class="progress-label">Progress to degree</span>
      <span class="progress-pct">{progress}%</span>
    </div>
    <div class="progress-track">
      <div class="progress-fill" style={`width: ${progress}%`}></div>
    </div>
    <p class="progress-end">Jun 2027</p>
  </div>
</article>

<style>
  .now-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 22px;
    border-radius: 24px;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(120% 80% at 0% 0%, rgba(255, 203, 107, 0.6), transparent 50%),
      radial-gradient(120% 80% at 100% 100%, rgba(255, 106, 42, 0.55), transparent 50%),
      linear-gradient(135deg, #ff8a3d 0%, #ff6a2a 100%);
    border: 1px solid rgba(255, 220, 170, 0.4);
    box-shadow:
      0 8px 32px -8px rgba(0, 0, 0, 0.12),
      0 4px 16px -4px rgba(0, 0, 0, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.8),
      0 30px 80px -20px rgba(255, 106, 42, 0.5);
    color: #fff;
    min-height: 180px;
    box-sizing: border-box;
    animation: rise 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .now-card:hover {
    transform: translateY(-4px);
  }

  .now-card::after {
    content: "";
    position: absolute;
    right: -80px;
    bottom: -80px;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 138, 61, 0.4), transparent 60%);
    filter: blur(40px);
    pointer-events: none;
  }

  .now-card > * {
    position: relative;
    z-index: 1;
  }

  .stats-tag {
    margin: 0;
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .stats-num {
    margin: 0;
    color: white;
    font-family: var(--font-display);
    font-size: clamp(48px, 5vw, 64px);
    font-weight: 800;
    line-height: 0.9;
  }

  .stats-label {
    margin: 4px 0 0;
    color: rgba(255, 255, 255, 0.9);
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.4;
  }

  .progress-section {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 12px;
  }

  .progress-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .progress-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }

  .progress-pct {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.95);
  }

  .progress-track {
    height: 5px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.22);
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.9);
    transition: width 1s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .progress-end {
    margin: 0;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.55);
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>
