---
interface Props {
  email?: string;
  github?: string;
  linkedin?: string;
  resumeUrl?: string;
}

const {
  email = 'thomas@skjerdal.me',
  github = 'https://github.com/skjerdal',
  linkedin = 'https://linkedin.com/in/thomas-skjerdal-8ba458283',
  resumeUrl = '/resume.pdf',
} = Astro.props;

const uid = Math.random().toString(36).slice(2, 7);
const emailId = `email-link-${uid}`;
const labelId = `email-label-${uid}`;
---

<article class="contact-card">
  <div class="orbits" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
    <span class="spark"></span>
  </div>
  <div class="contact-copy">
    <p class="eyebrow">Get in touch</p>
    <h2>Let's build something.</h2>
  </div>
  <div class="contact-actions">
    <a class="contact-btn" id={emailId} href={`mailto:${email}`} data-email={email}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <path d="m3 7 9 6 9-6"></path>
      </svg>
      <span id={labelId}>{email}</span>
    </a>
    <a class="contact-btn" href={github} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.1-1.3-.3-2.6-1.2-3.6.3-1.1.3-2.3-.1-3.4 0 0-1-.3-3.5 1.3a12.3 12.3 0 0 0-6.4 0C6.3 1.7 5.3 2 5.3 2c-.4 1.1-.4 2.3-.1 3.4A5.2 5.2 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.4.5-.7 1.2-.8 2"></path>
        <path d="M9 18c-4.5 2-5-2-7-2"></path>
      </svg>
      GitHub
    </a>
    <a class="contact-btn" href={linkedin} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path>
        <rect x="2" y="9" width="4" height="12"></rect>
        <circle cx="4" cy="4" r="2"></circle>
      </svg>
      LinkedIn
    </a>
    <a class="contact-btn primary" href={resumeUrl} download="Thomas_Skjerdal_Resume.pdf">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <path d="m7 10 5 5 5-5"></path>
        <path d="M12 15V3"></path>
      </svg>
      Resume
    </a>
  </div>
</article>

<script define:vars={{ emailId, labelId, email }}>
  const emailLink = document.getElementById(emailId);
  const emailLabel = document.getElementById(labelId);

  emailLink?.addEventListener('click', (event) => {
    if (!navigator.clipboard) return;
    event.preventDefault();
    navigator.clipboard.writeText(email).then(() => {
      if (!emailLabel) return;
      emailLabel.textContent = 'Copied!';
      window.setTimeout(() => { emailLabel.textContent = email; }, 1800);
    });
  });
</script>

<style>
  .contact-card {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 20px;
    padding: 22px;
    border-radius: 24px;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(120% 80% at 0% 0%, rgba(255, 203, 107, 0.6), transparent 50%),
      radial-gradient(120% 80% at 100% 100%, rgba(255, 106, 42, 0.55), transparent 50%),
      linear-gradient(135deg, #ff8a3d 0%, #ff6a2a 100%);
    border: 1px solid rgba(255, 220, 170, 0.4);
    box-shadow:
      0 8px 32px -8px rgba(0, 0, 0, 0.12),
      0 4px 16px -4px rgba(0, 0, 0, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.8),
      0 30px 80px -20px rgba(255, 106, 42, 0.5);
    color: #fff;
    min-height: 180px;
    box-sizing: border-box;
    animation: rise 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    font-family: var(--font-sans);
    -webkit-tap-highlight-color: transparent;
  }

  .contact-card:hover {
    transform: translateY(-4px);
  }

  .contact-copy,
  .contact-actions {
    position: relative;
    z-index: 2;
  }

  .eyebrow {
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  h2 {
    margin: 8px 0 0;
    color: white;
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 700;
    line-height: 1;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
    margin-left: auto;
  }

  .contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 10px 14px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    color: white;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    backdrop-filter: blur(10px);
    transition: transform 0.2s, background 0.2s;
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
  }

  .contact-btn:hover {
    transform: translateY(-1px);
    background: rgba(255, 255, 255, 0.28);
  }

  .contact-btn.primary {
    border-color: rgba(20, 16, 13, 0.9);
    background: rgba(20, 16, 13, 0.9);
  }

  .contact-btn.primary:hover {
    background: #1a1410;
  }

  .contact-btn svg {
    width: 14px;
    height: 14px;
    flex: 0 0 14px;
  }

  .orbits {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .orbits span {
    position: absolute;
    top: 50%;
    right: -40%;
    aspect-ratio: 1;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    transform: translateY(-50%);
  }

  .orbits span:nth-child(1) { width: 120%; }
  .orbits span:nth-child(2) { right: -30%; width: 90%; }
  .orbits span:nth-child(3) { right: -20%; width: 60%; }

  .orbits .spark {
    top: 30%;
    right: 20%;
    width: 10px;
    height: 10px;
    border: 0;
    background: white;
    box-shadow: 0 0 20px white;
    animation: orbit 6s linear infinite;
  }

  @media (max-width: 600px) {
    .contact-card {
      align-items: flex-start;
      flex-direction: column;
    }

    .contact-actions {
      justify-content: flex-start;
      margin-left: 0;
    }
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes orbit {
    from { transform: rotate(0deg) translateX(40px) rotate(0deg); }
    to   { transform: rotate(360deg) translateX(40px) rotate(-360deg); }
  }
</style>
