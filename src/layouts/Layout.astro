---
import '../styles/global.scss'
import '../styles/main.scss'
import Analytics from '@vercel/analytics/astro';
import LanguageSwitcher from '../components/LanguageSwitcher.vue';

interface Props {
	title: string;
	description?: string;
}

const {
  title,
  description = 'Thomas Skjerdal — MSc student in AI at NTNU and part-time developer at Omega 365. Personal portfolio showcasing projects, skills, and experience.'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://skjerdal.me');
const ogImage = 'https://skjerdal.me/profil.jpg';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Thomas Skjerdal" />

    <!-- Open Graph (LinkedIn, Facebook, iMessage previews) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Thomas Skjerdal" />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" href="/computertype.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Syne:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Structured data: Person -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Thomas Skjerdal",
        "url": "https://skjerdal.me",
        "image": "https://skjerdal.me/profil.jpg",
        "jobTitle": "Software Developer",
        "alumniOf": {
          "@type": "CollegeOrUniversity",
          "name": "NTNU"
        },
        "worksFor": {
          "@type": "Organization",
          "name": "Omega 365 Solutions"
        },
        "sameAs": [
          "https://github.com/skjerdal",
          "https://www.linkedin.com/in/thomas-skjerdal"
        ]
      }
    </script>
  </head>

  <script>
    // Initialize with light theme by default
    document.body.classList.add('theme-light');
  </script>

  <body class="theme-light">
    <div class="lang-switcher-wrapper">
      <LanguageSwitcher client:load />
    </div>
    <div class="page-container">
      <div class="background-card"></div>
      <div class="theme-container">
        <slot />
      </div>
    </div>
    <Analytics />
  </body>

</html>

<style>
  body {
    margin: 0;
    padding: 0;
  }
  
  .page-container {
    position: relative;
    min-height: 100vh;
    width: 100%;
    padding: 2px;
    box-sizing: border-box;
  }

  .lang-switcher-wrapper {
    position: fixed;
    top: 15px;
    right: 15px;
    z-index: 1000;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .lang-switcher-wrapper:hover {
    opacity: 1;
  }

  .background-card {
    position: absolute;
    top: 4px;
    left: 6px;
    right: 6px;
    bottom: 6px;
    background-color: rgba(240, 240, 240, 0.5);
    border-radius: 40px;
    border: 1px solid rgba(200, 200, 200, 0.3);
    box-shadow: 0 10px 50px rgba(0, 0, 0, 0.05);
    z-index: -1;
    backdrop-filter: blur(5px);
  }

  /* Dark theme version of the background card */
  .theme-dark .background-card {
    background-color: rgba(40, 40, 45, 0.5);
    border: 1px solid rgba(60, 60, 65, 0.3);
    box-shadow: 0 10px 50px rgba(0, 0, 0, 0.2);
  }

  .theme-container {
    min-height: 100%;
    position: relative;
    padding: 25px 0 39px 0;
  }
</style>

