---
import Layout from '../layouts/Layout.astro';
import CardWrapper from '../components/CardWrapper.astro';
import NowCard from '../reuse-components/NowCard.astro';
import StackCard from '../reuse-components/StackCard.astro';
import ContactCard from '../reuse-components/ContactCard.astro';
import { cards } from '../data/cardContent';

const cardById = new Map(cards.map((card) => [card.id, card]));
const aboutCard = cardById.get('about-me');
const projectsCard = cardById.get('projects');
const boosterCard = cardById.get('booster-pack');
const timelineCard = cardById.get('timeline');

const mainCards = [projectsCard, boosterCard, timelineCard].filter(
  (card): card is NonNullable<typeof card> => Boolean(card),
);
---

<Layout title="Thomas Skjerdal - Personal Website">
  <main class="container">
    <div class="card-grid">
      {aboutCard && (
        <CardWrapper
          cardId={aboutCard.id}
          isUnique={aboutCard.isUnique}
          title={aboutCard.title}
          content={aboutCard.content}
          componentName={aboutCard.component}
          position={aboutCard.position}
          className="card"
          videoPath={aboutCard.videoPath}
          customStyle={aboutCard.customStyle}
        />
      )}
      <div class="card-pair">
        <NowCard />
        <StackCard />
      </div>
      {mainCards.map((card) => (
        <CardWrapper
          cardId={card.id}
          isUnique={card.isUnique}
          title={card.title}
          content={card.content}
          componentName={card.component}
          position={card.position}
          className="card"
          videoPath={card.videoPath}
          customStyle={card.customStyle}
        />
      ))}
      <div class="contact-wrapper">
        <ContactCard />
      </div>
    </div>
  </main>
</Layout>

<style>
  .card-pair {
    grid-column: span 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
    opacity: 0;
    transform: translateY(30px);
    animation: pair-fly-in 0.4s ease-out 200ms forwards;
  }

  .contact-wrapper {
    grid-column: 1 / -1;
    opacity: 0;
    transform: translateY(30px);
    animation: pair-fly-in 0.4s ease-out forwards;
  }

  @keyframes pair-fly-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
</script>
